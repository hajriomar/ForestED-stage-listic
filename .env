# ForestED — variables d'environnement (copier vers .env, ne jamais commiter .env)

APP_ENV=development

# ── Backend ──────────────────────────────────────────────
# Obligatoire en production. Générer avec :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# JWT
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Base de données (SQLite en dev, PostgreSQL en prod)
#DATABASE_URL=sqlite:///./forested.db

# API keys
API_KEY_PREFIX=fed_

# ── Frontend Dash ────────────────────────────────────────
# Signature du cookie de session (contient le token JWT).
# Obligatoire en production. Générer avec :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=

# URL du backend vue depuis le conteneur frontend
API_BASE_URL=http://backend:8000/api/v1