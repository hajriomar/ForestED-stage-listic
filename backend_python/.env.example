# ═══ ForestED — variables d'environnement (Patch B) ═══
# Copier en .env puis remplir. NE JAMAIS committer le .env réel.

# — Sécurité (OBLIGATOIRE en production ; générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=
FLASK_SECRET_KEY=

# — Environnement : development | production
#   production => /docs désactivés, cookies Secure, secret obligatoire
APP_ENV=development

# — Base d'auth (PostgreSQL — Patch B). Le mot de passe par défaut
#   "forested" est acceptable en dev local UNIQUEMENT.
POSTGRES_PASSWORD=forested
# DATABASE_URL est construit par docker-compose ; ne le surcharger que
# pour un cas particulier (ex. retour temporaire à SQLite) :
# DATABASE_URL=sqlite:///./forested.db

# — Hôtes autorisés (production) : domaines publics, séparés par des
#   virgules. Les hosts internes (localhost, 127.0.0.1, backend) sont
#   TOUJOURS ajoutés automatiquement (voir app/config.py).
# TRUSTED_HOSTS=api.mondomaine.fr,app.mondomaine.fr

# — Frontend
API_BASE_URL=http://backend:8000/api/v1
DASHBOARD_BASE_URL=http://127.0.0.1:8050

# ═══ Production / Caddy (Patch C1) ═══
# — Domaines publics (DNS A/AAAA pointant vers le serveur)
DOMAIN=exemple.fr
APP_DOMAIN=app.exemple.fr
API_DOMAIN=api.exemple.fr
# — Email du compte Let's Encrypt (expiration/alertes certificats)
ACME_EMAIL=adresse@example.fr
# — Hôtes autorisés par l'API (les hosts internes Docker sont ajoutés
#   automatiquement — voir app/config.py)

TRUSTED_HOSTS=app.exemple.fr,api.exemple.fr
